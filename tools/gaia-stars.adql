SELECT g.source_id, g.ra, g.dec, g.pmra, g.pmdec, g.parallax,
       g.phot_g_mean_mag, g.bp_rp,
       t.original_ext_source_id AS tyc, h.original_ext_source_id AS hip
FROM gaiadr3.gaia_source AS g
LEFT OUTER JOIN gaiadr3.tycho2tdsc_merge_best_neighbour AS t ON g.source_id = t.source_id
LEFT OUTER JOIN gaiadr3.hipparcos2_best_neighbour AS h ON g.source_id = h.source_id
WHERE g.phot_g_mean_mag < 12.1
  AND g.bp_rp BETWEEN -0.5 AND 5.0
  AND g.phot_g_mean_mag + 0.02704 - 0.01424*g.bp_rp
      + 0.2156*POWER(g.bp_rp, 2) - 0.01426*POWER(g.bp_rp, 3) <= 12.0
